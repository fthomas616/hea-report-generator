<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HEA System Configuration</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Segoe UI',Arial,sans-serif; background:linear-gradient(135deg,#1e3c72,#2a5298); min-height:100vh; padding:20px; color:#333; line-height:1.6; }
    .setup-container { max-width:700px; margin:0 auto; background:white; border-radius:16px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5); }
    .setup-header { background:linear-gradient(135deg,#667eea,#764ba2); color:white; padding:30px; text-align:center; }
    .setup-header h2 { font-size:26px; margin-bottom:8px; }
    .setup-header p { opacity:0.9; font-size:15px; }
    .setup-body { padding:30px; }

    /* Progress */
    .setup-progress { display:flex; justify-content:center; align-items:center; gap:0; margin-bottom:30px; }
    .progress-step { display:flex; flex-direction:column; align-items:center; gap:5px; }
    .progress-dot { width:36px; height:36px; border-radius:50%; background:#e9ecef; color:#adb5bd; font-weight:700; font-size:15px; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
    .progress-dot.active { background:linear-gradient(135deg,#667eea,#764ba2); color:white; box-shadow:0 4px 12px rgba(102,126,234,0.4); }
    .progress-dot.done { background:#28a745; color:white; }
    .progress-label { font-size:11px; color:#6c757d; text-align:center; font-weight:600; white-space:nowrap; }
    .progress-line { width:40px; height:2px; background:#e9ecef; margin-bottom:16px; transition:background 0.3s; }
    .progress-line.done { background:#28a745; }

    /* Sections */
    .setup-section { display:none; }
    .setup-section.active { display:block; }
    .setup-section h3 { font-size:18px; color:#667eea; margin-bottom:20px; padding-bottom:10px; border-bottom:2px solid #f0f0f0; }
    .section-divider { background:#f8f9fa; border-left:4px solid #667eea; padding:10px 15px; margin:20px 0 15px; border-radius:0 6px 6px 0; font-weight:700; font-size:13px; color:#495057; }

    /* Form */
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:15px; margin-bottom:15px; }
    .form-row.three { grid-template-columns:1fr 1fr 1fr; }
    .form-row.one { grid-template-columns:1fr; }
    @media(max-width:600px) { .form-row,.form-row.three { grid-template-columns:1fr; } }
    .form-group { display:flex; flex-direction:column; gap:6px; }
    .form-group label { font-weight:600; font-size:13px; color:#495057; }
    .form-group input, .form-group select { padding:10px 12px; border:1px solid #ced4da; border-radius:6px; font-size:14px; background:white; }
    .form-group input:focus, .form-group select:focus { outline:none; border-color:#667eea; box-shadow:0 0 0 3px rgba(102,126,234,0.15); }
    .hint { font-size:11px; color:#adb5bd; margin-top:2px; }
    .calc-field { background:#e8f5e9; border:1px solid #28a745; border-radius:6px; padding:10px 12px; font-size:14px; font-weight:700; color:#155724; }
    .rate-wrap { position:relative; }
    .rate-wrap span { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#6c757d; font-weight:600; }
    .rate-wrap input { padding-left:24px; }

    /* TOU blocks */
    .tou-block { background:#f8f9fa; border:1px solid #dee2e6; border-radius:8px; padding:15px; margin-bottom:12px; }
    .tou-block-title { font-weight:700; font-size:13px; color:#667eea; margin-bottom:10px; }
    .time-range { display:flex; align-items:center; gap:8px; }
    .time-range select { flex:1; font-size:13px; padding:8px; border:1px solid #ced4da; border-radius:6px; }
    .time-range span { color:#6c757d; font-weight:600; font-size:13px; }

    /* Day checkboxes */
    .day-checkboxes { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
    .day-check { display:flex; align-items:center; gap:5px; background:#e9ecef; padding:6px 12px; border-radius:20px; cursor:pointer; font-size:13px; font-weight:600; transition:all 0.2s; user-select:none; }
    .day-check.checked { background:linear-gradient(135deg,#667eea,#764ba2); color:white; }

    /* Month toggles */
    .month-checkboxes { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }
    .month-check { background:#e9ecef; padding:6px 12px; border-radius:15px; cursor:pointer; font-size:13px; font-weight:600; transition:all 0.2s; user-select:none; }
    .month-check.s1 { background:#667eea; color:white; }
    .month-check.s2 { background:#28a745; color:white; }

    /* Nav */
    .setup-nav { display:flex; justify-content:space-between; align-items:center; margin-top:30px; padding-top:20px; border-top:1px solid #e9ecef; }
    .btn-setup { padding:12px 28px; border:none; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; transition:all 0.2s; }
    .btn-next { background:linear-gradient(135deg,#667eea,#764ba2); color:white; }
    .btn-next:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(102,126,234,0.4); }
    .btn-back { background:#e9ecef; color:#495057; }
    .btn-save { background:linear-gradient(135deg,#28a745,#20c997); color:white; }
    .btn-save:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(40,167,69,0.4); }
    .season-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:10px; }
    .season-card { border-radius:8px; padding:12px; font-size:12px; line-height:1.8; }
  </style>
</head>
<body>
<div class="setup-container">
  <div class="setup-header">
    <div style="font-size:40px; margin-bottom:10px;">🔋</div>
    <h2 id="pageTitle">HEA System Configuration</h2>
    <p id="pageSubtitle">Set up your system once — never enter it again</p>
  </div>
  <div class="setup-body">

    <!-- Progress Bar -->
    <div class="setup-progress">
      <div class="progress-step">
        <div class="progress-dot active" id="dot1">1</div>
        <div class="progress-label">System</div>
      </div>
      <div class="progress-line" id="line1"></div>
      <div class="progress-step">
        <div class="progress-dot" id="dot2">2</div>
        <div class="progress-label">TOU Hours</div>
      </div>
      <div class="progress-line" id="line2"></div>
      <div class="progress-step">
        <div class="progress-dot" id="dot3">3</div>
        <div class="progress-label">Seasons</div>
      </div>
      <div class="progress-line" id="line3"></div>
      <div class="progress-step">
        <div class="progress-dot" id="dot4">4</div>
        <div class="progress-label">Rates</div>
      </div>
    </div>

    <!-- ── STEP 1: HARDWARE ───────────────────────── -->
    <div class="setup-section active" id="step1">
      <h3>⚡ Step 1 of 4 — Your System Hardware</h3>

      <div class="section-divider">🔌 Inverter</div>
      <div class="form-row three">
        <div class="form-group">
          <label>Brand</label>
          <select id="inverterBrand">
            <option value="EG4">EG4</option>
            <option value="Victron">Victron</option>
            <option value="Sol-Ark">Sol-Ark</option>
            <option value="Growatt">Growatt</option>
            <option value="Deye">Deye</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Model</label>
          <input type="text" id="inverterModel" value="6000XP">
        </div>
        <div class="form-group">
          <label>Count</label>
          <select id="inverterCount" onchange="calcKw()">
            <option value="1">1</option>
            <option value="2">2 (Parallel)</option>
            <option value="3">3</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>kW Per Unit</label>
          <input type="number" id="inverterKwEach" value="6" step="0.1" oninput="calcKw()">
        </div>
        <div class="form-group">
          <label>Total System kW</label>
          <div class="calc-field" id="totalKw">6.0 kW</div>
        </div>
      </div>

      <div class="section-divider">🔋 Battery</div>
      <div class="form-row three">
        <div class="form-group">
          <label>Brand</label>
          <select id="batteryBrand">
            <option value="Eco-Worthy">Eco-Worthy</option>
            <option value="Pylontech">Pylontech</option>
            <option value="LiTime">LiTime</option>
            <option value="SOK">SOK</option>
            <option value="Ampere Time">Ampere Time</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Model</label>
          <input type="text" id="batteryModel" value="48V 100Ah V3">
        </div>
        <div class="form-group">
          <label>Count</label>
          <select id="batteryCount" onchange="calcKwh()">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4" selected>4</option>
            <option value="6">6</option>
            <option value="8">8</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>kWh Per Battery</label>
          <input type="number" id="batteryKwhEach" value="5.12" step="0.01" oninput="calcKwh()">
        </div>
        <div class="form-group">
          <label>Total Battery kWh</label>
          <div class="calc-field" id="totalKwh">20.48 kWh</div>
        </div>
      </div>

      <div class="section-divider">☀️ Solar &amp; Switch</div>
      <div class="form-row">
        <div class="form-group">
          <label>Solar Watts <span style="font-weight:400;color:#adb5bd;">(optional)</span></label>
          <input type="number" id="solarWatts" value="440" step="10">
        </div>
        <div class="form-group">
          <label>Solar Controller</label>
          <select id="solarController">
            <option value="Delta 2 Max">EcoFlow Delta 2 Max</option>
            <option value="Delta Pro">EcoFlow Delta Pro</option>
            <option value="EG4 MPPT">EG4 MPPT</option>
            <option value="Victron MPPT">Victron MPPT</option>
            <option value="None">No Solar</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Transfer Switch</label>
          <select id="transferSwitch">
            <option value="Reliance 510C 50A">Reliance 510C 50A</option>
            <option value="Reliance 310C 30A">Reliance 310C 30A</option>
            <option value="Generac 200A">Generac 200A</option>
            <option value="None">None</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Utility Company</label>
          <select id="utilityCompany" onchange="preloadUtility()">
            <option value="PEPCO">PEPCO (MD/DC/VA)</option>
            <option value="BGE">BGE (Maryland)</option>
            <option value="Dominion">Dominion (Virginia)</option>
            <option value="PGE">PG&amp;E (California)</option>
            <option value="SCE">SCE (California)</option>
            <option value="Oncor">Oncor (Texas)</option>
            <option value="FPL">FPL (Florida)</option>
            <option value="APS">APS (Arizona)</option>
            <option value="Duke">Duke Energy</option>
            <option value="ConEd">ConEd (New York)</option>
            <option value="Other">Other / Custom</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>System Cost ($) <span style="font-weight:400;color:#adb5bd;">for ROI tracking</span></label>
          <div class="rate-wrap">
            <span>$</span>
            <input type="number" id="systemCost" value="0" step="100">
          </div>
        </div>
        <div class="form-group">
          <label>Install Date <span style="font-weight:400;color:#adb5bd;">for ROI tracking</span></label>
          <input type="month" id="installDate">
        </div>
      </div>

      <div class="setup-nav">
        <div></div>
        <button class="btn-setup btn-next" onclick="goStep(2)">Next: TOU Hours →</button>
      </div>
    </div>

    <!-- ── STEP 2: TOU HOURS BY SEASON ────────────── -->
    <div class="setup-section" id="step2">
      <h3>⏰ Step 2 of 4 — TOU Hours &amp; Seasons</h3>
      <p style="color:#6c757d;font-size:13px;margin-bottom:20px;">
        Name your seasons and set peak hours for each. Your battery uses
        these to know exactly when it must cover your load.
      </p>

      <!-- SEASON 1 -->
      <div class="tou-block" style="border:2px solid #667eea;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="font-size:22px;">❄️</span>
          <input type="text" id="season1Name" value="Winter"
            style="border:none;border-bottom:2px solid #667eea;border-radius:0;
                   font-size:17px;font-weight:700;color:#667eea;flex:1;
                   padding:2px 4px;background:transparent;"
            placeholder="Season 1 name">
          <span style="font-size:11px;color:#adb5bd;">tap to edit</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:10px;">
          <div>
            <div style="font-size:11px;font-weight:700;color:#667eea;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">🌅 Morning Peak</div>
            <div class="time-range">
              <select id="s1MornStart"><option value="none">None</option><option value="5">5AM</option><option value="6" selected>6AM</option><option value="7">7AM</option><option value="8">8AM</option></select>
              <span>→</span>
              <select id="s1MornEnd"><option value="none">—</option><option value="7">7AM</option><option value="8">8AM</option><option value="9" selected>9AM</option><option value="10">10AM</option></select>
            </div>
          </div>
          <div>
            <div style="font-size:11px;font-weight:700;color:#667eea;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">🌆 Evening Peak</div>
            <div class="time-range">
              <select id="s1EveStart"><option value="none">None</option><option value="14">2PM</option><option value="15">3PM</option><option value="16">4PM</option><option value="17" selected>5PM</option><option value="18">6PM</option></select>
              <span>→</span>
              <select id="s1EveEnd"><option value="19">7PM</option><option value="20">8PM</option><option value="21" selected>9PM</option><option value="22">10PM</option></select>
            </div>
          </div>
        </div>
        <div style="background:rgba(102,126,234,0.08);border-radius:5px;padding:7px 10px;font-size:11px;color:#667eea;">⚡ Off-Peak: all hours outside above windows — auto calculated</div>
      </div>

      <!-- SEASON 2 -->
      <div class="tou-block" style="border:2px solid #28a745;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="font-size:22px;">☀️</span>
          <input type="text" id="season2Name" value="Summer"
            style="border:none;border-bottom:2px solid #28a745;border-radius:0;
                   font-size:17px;font-weight:700;color:#28a745;flex:1;
                   padding:2px 4px;background:transparent;"
            placeholder="Season 2 name">
          <span style="font-size:11px;color:#adb5bd;">tap to edit</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:10px;">
          <div>
            <div style="font-size:11px;font-weight:700;color:#28a745;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">🌅 Morning Peak</div>
            <div class="time-range">
              <select id="s2MornStart"><option value="none" selected>None</option><option value="5">5AM</option><option value="6">6AM</option><option value="7">7AM</option><option value="8">8AM</option></select>
              <span>→</span>
              <select id="s2MornEnd"><option value="none" selected>—</option><option value="7">7AM</option><option value="8">8AM</option><option value="9">9AM</option><option value="10">10AM</option></select>
            </div>
          </div>
          <div>
            <div style="font-size:11px;font-weight:700;color:#28a745;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">🌆 Evening Peak</div>
            <div class="time-range">
              <select id="s2EveStart"><option value="none">None</option><option value="14">2PM</option><option value="15" selected>3PM</option><option value="16">4PM</option><option value="17">5PM</option><option value="18">6PM</option></select>
              <span>→</span>
              <select id="s2EveEnd"><option value="19">7PM</option><option value="20" selected>8PM</option><option value="21">9PM</option><option value="22">10PM</option></select>
            </div>
          </div>
        </div>
        <div style="background:rgba(40,167,69,0.08);border-radius:5px;padding:7px 10px;font-size:11px;color:#28a745;">⚡ Off-Peak: all hours outside above windows — auto calculated</div>
      </div>

      <!-- PEAK DAYS -->
      <div class="tou-block">
        <div class="tou-block-title">📅 Peak Days <span style="font-weight:400;font-size:12px;color:#6c757d;">— applies to both seasons</span></div>
        <div class="day-checkboxes">
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="1" style="display:none"> Mon</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="2" style="display:none"> Tue</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="3" style="display:none"> Wed</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="4" style="display:none"> Thu</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="5" style="display:none"> Fri</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="6" style="display:none"> Sat</label>
          <label class="day-check" onclick="toggleDay(this)"><input type="checkbox" value="0" style="display:none"> Sun</label>
        </div>
        <div style="margin-top:10px;display:flex;gap:10px;">
          <button onclick="setWeekdays()" style="padding:6px 14px;background:#667eea;color:white;border:none;border-radius:5px;font-size:12px;cursor:pointer;font-weight:600;">Weekdays Only</button>
          <button onclick="setAllDays()" style="padding:6px 14px;background:#764ba2;color:white;border:none;border-radius:5px;font-size:12px;cursor:pointer;font-weight:600;">All 7 Days</button>
        </div>
      </div>

      <div class="setup-nav">
        <button class="btn-setup btn-back" onclick="goStep(1)">← Back</button>
        <button class="btn-setup btn-next" onclick="goStep(3)">Next: Month Assignment →</button>
      </div>
    </div>

    <!-- ── STEP 3: MONTH ASSIGNMENT ───────────────── -->
    <div class="setup-section" id="step3">
      <h3>📅 Step 3 of 4 — Assign Months to Seasons</h3>
      <p style="color:#6c757d;font-size:13px;margin-bottom:20px;">
        Tap each month to assign it to
        <strong style="color:#667eea;" id="s1Label">Winter</strong> or
        <strong style="color:#28a745;" id="s2Label">Summer</strong>.
        Rates and peak hours switch automatically each month.
      </p>

      <div class="tou-block">
        <div class="tou-block-title">Tap to toggle:</div>
        <div class="month-checkboxes" id="monthGrid"></div>
        <div style="display:flex;gap:20px;margin-top:12px;font-size:12px;flex-wrap:wrap;justify-content:center;">
          <span style="display:flex;align-items:center;gap:6px;"><span style="width:14px;height:14px;background:#667eea;border-radius:3px;display:inline-block;"></span><span id="leg1">❄️ Winter</span></span>
          <span style="display:flex;align-items:center;gap:6px;"><span style="width:14px;height:14px;background:#28a745;border-radius:3px;display:inline-block;"></span><span id="leg2">☀️ Summer</span></span>
        </div>
      </div>

      <div class="season-grid">
        <div class="season-card" style="background:#f0f2ff;border:1px solid #667eea;">
          <div style="font-weight:700;color:#667eea;margin-bottom:6px;">❄️ <span id="s1CardTitle">Winter</span></div>
          <div id="s1Months" style="font-size:12px;color:#495057;"></div>
          <div id="s1Hours" style="font-size:11px;color:#667eea;margin-top:5px;padding-top:5px;border-top:1px solid #dee2e6;"></div>
        </div>
        <div class="season-card" style="background:#f0fff4;border:1px solid #28a745;">
          <div style="font-weight:700;color:#28a745;margin-bottom:6px;">☀️ <span id="s2CardTitle">Summer</span></div>
          <div id="s2Months" style="font-size:12px;color:#495057;"></div>
          <div id="s2Hours" style="font-size:11px;color:#28a745;margin-top:5px;padding-top:5px;border-top:1px solid #dee2e6;"></div>
        </div>
      </div>

      <div class="setup-nav">
        <button class="btn-setup btn-back" onclick="goStep(2)">← Back</button>
        <button class="btn-setup btn-next" onclick="goStep(4)">Next: Rates →</button>
      </div>
    </div>

    <!-- ── STEP 4: RATES ──────────────────────────── -->
    <div class="setup-section" id="step4">
      <h3>💰 Step 4 of 4 — Utility Rates</h3>
      <p style="color:#6c757d;font-size:13px;margin-bottom:20px;">
        Enter your current rates. Find them on your bill under "Rate Schedule" or "Supply Charges".
      </p>

      <div class="section-divider">❄️ <span id="s1RateTitle">Winter</span> Rates</div>
      <div class="form-row three">
        <div class="form-group"><label>Peak Supply Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s1PeakRate" value="0.2240" step="0.0001"></div><div class="hint">per kWh</div></div>
        <div class="form-group"><label>Off-Peak Supply Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s1OffRate" value="0.1060" step="0.0001"></div><div class="hint">per kWh</div></div>
        <div class="form-group"><label>Delivery / Fees Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s1Delivery" value="0.0731" step="0.0001"></div><div class="hint">per kWh blended</div></div>
      </div>

      <div class="section-divider">☀️ <span id="s2RateTitle">Summer</span> Rates</div>
      <div class="form-row three">
        <div class="form-group"><label>Peak Supply Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s2PeakRate" value="0.5751" step="0.0001"></div><div class="hint">per kWh</div></div>
        <div class="form-group"><label>Off-Peak Supply Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s2OffRate" value="0.1060" step="0.0001"></div><div class="hint">per kWh</div></div>
        <div class="form-group"><label>Delivery / Fees Rate</label><div class="rate-wrap"><span>$</span><input type="number" id="s2Delivery" value="0.0731" step="0.0001"></div><div class="hint">per kWh blended</div></div>
      </div>

      <div class="section-divider">Flat Rate Reference</div>
      <div class="form-row">
        <div class="form-group"><label>Flat Rate (no TOU)</label><div class="rate-wrap"><span>$</span><input type="number" id="flatRate" value="0.2107" step="0.0001"></div><div class="hint">for savings comparison</div></div>
        <div class="form-group"><label>Rate Last Updated</label><input type="month" id="rateDate"></div>
      </div>

      <div style="background:#e8f4fd;border:1px solid #667eea;border-radius:8px;padding:12px 15px;margin-top:10px;font-size:13px;color:#0c5460;">
        💡 <strong>PEPCO customers:</strong> rates are pre-filled above ✅
      </div>

      <div class="setup-nav">
        <button class="btn-setup btn-back" onclick="goStep(3)">← Back</button>
        <button class="btn-setup btn-save" onclick="saveAndLaunch()">✅ Save &amp; Launch HEA Tool</button>
      </div>
    </div>

  </div><!-- /setup-body -->
</div><!-- /setup-container -->

